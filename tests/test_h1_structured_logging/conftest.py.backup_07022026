class LogCapture:
    def __init__(self):
        self.events: List[Dict[str, Any]] = []
    
    def has_event(self, event_name: str) -> bool:
        for e in self.events:
            if e.get("event") == event_name:
                return True
        return False
    
    def get_event(self, event_name: str) -> Dict[str, Any]:
        for event in self.events:
            if event.get("event") == event_name:
                return event
        return {}
    
    def get_events(self, event_name: str) -> List[Dict[str, Any]]:
        return [e for e in self.events if e.get("event") == event_name]
    
    def clear(self):
        self.events.clear()


@pytest.fixture(scope='function')
def log_capture(monkeypatch):
    """
    ULTIMATE fixture that patches structlog AT THE SOURCE.
    """
    # STEP 1: Create capture BEFORE anything else
    capture = LogCapture()
    
    # STEP 2: Monkeypatch structlog.stdlib.BoundLogger methods
    # This is the class that actually gets instantiated
    import structlog.stdlib
    
    # Store original BoundLogger
    OriginalBoundLogger = structlog.stdlib.BoundLogger
    
    class CapturingBoundLogger(OriginalBoundLogger):
        def _proxy_to_logger(self, method_name, event=None, **event_kw):
            # Capture the event
            event_dict = {
                "event": event,
                "level": method_name,
                **event_kw
            }
            capture.events.append(event_dict)
            
            # Call parent
            return super()._proxy_to_logger(method_name, event, **event_kw)
    
    # Replace BoundLogger globally
    monkeypatch.setattr(structlog.stdlib, 'BoundLogger', CapturingBoundLogger)
    
    # STEP 3: Also patch structlog._config to use our class
    import structlog._config
    
    # Get current config
    config = structlog.get_config()
    
    # Reconfigure structlog with our BoundLogger
    structlog.configure(
        processors=config.get('processors', []),
        wrapper_class=CapturingBoundLogger,  # KEY: Use our class
        context_class=config.get('context_class', dict),
        logger_factory=config.get('logger_factory'),
        cache_logger_on_first_use=False,
    )
    
    # STEP 4: Force re-import of shopify_kb_client to use new config
