def assert_event_logged(
    log_capture,
    event_name: str,
    expected_fields: Dict[str, Any] = None
):
    """
    Assert that an event was logged with expected fields.
    
    Args:
        log_capture: LogCapture fixture
        event_name: Expected event name
        expected_fields: Dict of field_name: expected_value
    """
    assert log_capture.has_event(event_name), \
        f"Event '{event_name}' not found in captured events: {[e.get('event') for e in log_capture.events]}"
    
    if expected_fields:
        event = log_capture.get_event(event_name)
        for field_name, expected_value in expected_fields.items():
            assert field_name in event, \
                f"Field '{field_name}' not found in event '{event_name}'. Available fields: {list(event.keys())}"
            assert event[field_name] == expected_value, \
                f"Field '{field_name}' has value '{event[field_name]}', expected '{expected_value}'"


def assert_event_count(
    log_capture,
    event_name: str,
    expected_count: int
):
    """
    Assert that an event was logged exactly N times.
    
    Args:
        log_capture: LogCapture fixture
        event_name: Event name to count
        expected_count: Expected number of occurrences
    """
    events = log_capture.get_events(event_name)
    actual_count = len(events)
    assert actual_count == expected_count, \
        f"Event '{event_name}' logged {actual_count} times, expected {expected_count}"


def assert_error_logged(
    log_capture,
    event_name: str,
    with_exc_info: bool = True
):
    """
    Assert that an error event was logged.
    
    Args:
        log_capture: LogCapture fixture
        event_name: Error event name
        with_exc_info: Whether exc_info should be present
    """
    assert log_capture.has_event(event_name), \
        f"Error event '{event_name}' not found. Available events: {[e.get('event') for e in log_capture.events]}"
    
    event = log_capture.get_event(event_name)
    assert "error" in event or "error_type" in event, \
        f"Error event '{event_name}' missing error information. Available fields: {list(event.keys())}"
    
    if with_exc_info:
        assert event.get("exc_info") is True, \
            f"Error event '{event_name}' missing exc_info=True"