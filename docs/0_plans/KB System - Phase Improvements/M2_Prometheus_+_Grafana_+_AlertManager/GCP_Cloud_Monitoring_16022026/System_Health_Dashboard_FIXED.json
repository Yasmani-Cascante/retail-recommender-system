{
  "displayName": "Retail Recommender - System Health",
  "dashboardFilters": [],
  "description": "Executive overview - Service uptime, error budget, and alerts",
  "labels": {},
  "mosaicLayout": {
    "columns": 48,
    "tiles": [

      {
        "xPos": 0,
        "yPos": 0,
        "height": 8,
        "width": 16,
        "widget": {
          "title": "Container Instances Activas",
          "scorecard": {
            "sparkChartView": { "sparkChartType": "SPARK_LINE" },
            "thresholds": [
              { "label": "DOWN", "value": 0.5, "color": "RED", "direction": "BELOW" }
            ],
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "filter": "metric.type=\"run.googleapis.com/container/instance_count\" resource.type=\"cloud_run_revision\" resource.labels.service_name=\"retail-recommender\"",
                "aggregation": {
                  "alignmentPeriod": "60s",
                  "perSeriesAligner": "ALIGN_MEAN",
                  "crossSeriesReducer": "REDUCE_SUM",
                  "groupByFields": []
                }
              }
            }
          }
        }
      },

      {
        "xPos": 16,
        "yPos": 0,
        "height": 8,
        "width": 16,
        "widget": {
          "title": "Request Rate (req/sec)",
          "scorecard": {
            "sparkChartView": { "sparkChartType": "SPARK_LINE" },
            "thresholds": [],
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.labels.service_name=\"retail-recommender\"",
                "aggregation": {
                  "alignmentPeriod": "60s",
                  "perSeriesAligner": "ALIGN_RATE",
                  "crossSeriesReducer": "REDUCE_SUM",
                  "groupByFields": []
                }
              }
            }
          }
        }
      },

      {
        "xPos": 32,
        "yPos": 0,
        "height": 8,
        "width": 16,
        "widget": {
          "title": "KB Sync Semaphore Size",
          "scorecard": {
            "sparkChartView": { "sparkChartType": "SPARK_LINE" },
            "thresholds": [
              { "label": "BLOCKED", "value": 0.5, "color": "RED", "direction": "BELOW" }
            ],
            "timeSeriesQuery": {
              "timeSeriesFilter": {
                "filter": "metric.type=\"custom.googleapis.com/kb_sync_semaphore_size\" resource.type=\"generic_task\"",
                "aggregation": {
                  "alignmentPeriod": "60s",
                  "perSeriesAligner": "ALIGN_MEAN",
                  "crossSeriesReducer": "REDUCE_MEAN",
                  "groupByFields": []
                }
              }
            }
          }
        }
      },

      {
        "xPos": 0,
        "yPos": 8,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "Error Trends by Component",
          "xyChart": {
            "chartOptions": { "mode": "COLOR", "showLegend": true },
            "dataSets": [
              {
                "legendTemplate": "HTTP 5xx errors",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" resource.labels.service_name=\"retail-recommender\" metric.labels.response_code_class=\"5xx\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": []
                    }
                  }
                }
              },
              {
                "legendTemplate": "Recommender errors",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"custom.googleapis.com/recommender_errors_total\" resource.type=\"generic_task\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": []
                    }
                  }
                }
              },
              {
                "legendTemplate": "KB Sync failures",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"custom.googleapis.com/kb_sync_operations_total\" resource.type=\"generic_task\" metric.labels.status=\"failed\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": []
                    }
                  }
                }
              }
            ],
            "yAxis": { "label": "errors/sec", "scale": "LINEAR" }
          }
        }
      },

      {
        "xPos": 24,
        "yPos": 8,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "Cloud Run Request Latency p50 / p95 / p99",
          "xyChart": {
            "chartOptions": { "mode": "COLOR", "showLegend": true },
            "dataSets": [
              {
                "legendTemplate": "p50",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.labels.service_name=\"retail-recommender\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_50",
                      "groupByFields": []
                    }
                  }
                }
              },
              {
                "legendTemplate": "p95",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.labels.service_name=\"retail-recommender\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_95",
                      "groupByFields": []
                    }
                  }
                }
              },
              {
                "legendTemplate": "p99",
                "minAlignmentPeriod": "60s",
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/request_latencies\" resource.type=\"cloud_run_revision\" resource.labels.service_name=\"retail-recommender\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_PERCENTILE_99",
                      "groupByFields": []
                    }
                  }
                }
              }
            ],
            "yAxis": { "label": "ms", "scale": "LINEAR" }
          }
        }
      }

    ]
  }
}
