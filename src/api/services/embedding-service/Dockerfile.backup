# python:3.11-slim — requerido por pylate>=1.2.0 (usa typing.TypeAlias y otras
# features de Python 3.10+). Python 3.9 hace fallar 'pip install pylate' en build.
FROM python:3.11-slim

WORKDIR /app

# Instalar dependencias del sistema necesarias para torch y git (requerido por huggingface_hub)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ git && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# ── Paso 1: solo torch CPU-only ────────────────────────────────────────────
# Solo torch, sin torchvision.
#
# Por qué no instalar torchvision aquí:
#   torchvision==0.19.0+cpu (del índice PyTorch CPU) tiene en su metadata una
#   restricción de numpy que en el contexto de resolución global fuerza a pip
#   a bajar numpy a 1.26.4. Eso bloquea accelerate>=1.0.0 (requiere numpy 2.x)
#   que bloquea sentence-transformers 5.1.1 que bloquea pylate 1.4.0.
#   -> ResolutionImpossible (6 builds fallidos, 27/04/2026)
#
# torchvision la instala open-clip-torch desde PyPI como dependencia transitiva.
# La versión de PyPI es el build GPU, que produce un UserWarning sobre
# libc10_cuda.so al arrancar (no es un error fatal y no afecta funcionalidad
# porque visual_retriever.py no importa torchvision directamente).
RUN pip install --no-cache-dir \
    torch==2.7.0+cpu \
    --index-url https://download.pytorch.org/whl/cpu

# ── Paso 2: resto de dependencias ──────────────────────────────────────────
# --no-deps en torch NO funciona aquí porque torch es dependencia transitiva de
# fastkmeans (vía pylate). La protección real viene de tener torch==2.1.0+cpu
# en requirements.txt Y ya instalado — pip respetará la versión existente.
# Si pip intenta actualizar torch durante esta etapa, el build fallará con
# conflicto de versión (error visible en logs) en lugar de hacer override
# silencioso como ocurrió antes.
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Pre-descargar el modelo ColBERT durante el build de la imagen.
# Esto evita que el primer startup descargue ~350MB desde HuggingFace.
# El modelo se bake en la imagen Docker (~900MB total con torch CPU).
# FIX (23/04/2026): reemplazado heredoc (<< 'EOF') por python -c "...".
# Cloud Build usa el Docker daemon clásico (sin BuildKit) que no soporta
# heredocs — los interpreta como instrucciones Dockerfile y falla con
# "FROM requires either one or three arguments" al ver 'from pylate import'.
RUN HF_HUB_DOWNLOAD_TIMEOUT=300 HF_HUB_ETAG_TIMEOUT=60 \
    python -c "from pylate import models; models.ColBERT(model_name_or_path='LiquidAI/LFM2-ColBERT-350M'); print('ColBERT pre-downloaded successfully')"

# Pre-descargar Marqo/marqo-fashionSigLIP (añadido Opción A, 22/04/2026).
# El modelo pesa ~400MB (ViT-B-16-SigLIP fine-tuneado en moda).
# Con ColBERT (~350MB) + fashionSigLIP (~400MB), la imagen pesa ~1.7GB total.
# Build time adicional: ~3-5 min (una sola descarga desde HuggingFace Hub).
#
# open_clip.create_model_and_transforms('hf-hub:Marqo/marqo-fashionSigLIP'):
#   - Descarga los pesos del modelo desde HuggingFace
#   - Los cachea en ~/.cache/huggingface/hub/ dentro de la imagen
#   - En runtime, el modelo se carga desde este caché local (sin descarga)
# Mismo fix heredoc → python -c para FashionSigLIP.
RUN HF_HUB_DOWNLOAD_TIMEOUT=300 HF_HUB_ETAG_TIMEOUT=60 \
    python -c "import open_clip; print('Pre-downloading Marqo/marqo-fashionSigLIP...'); open_clip.create_model_and_transforms('hf-hub:Marqo/marqo-fashionSigLIP'); print('FashionSigLIP pre-downloaded')"

# ── Modo offline para HuggingFace en runtime ──────────────────────────────────
# Los dos modelos (ColBERT + fashionSigLIP) fueron pre-descargados en los pasos
# anteriores y están cacheados en /root/.cache/huggingface/hub/ dentro de la imagen.
#
# Por defecto, huggingface_hub intenta verificar la versión del modelo contra
# HuggingFace Hub en cada arranque (etag check via HTTP). Si esta llamada falla
# (timeout, DNS restringido en VPC, red no disponible), lanza una excepción que
# mata el proceso uvicorn — causando el 404 que estábamos viendo.
#
# Con HF_HUB_OFFLINE=1, la librería usa el caché local directamente, sin ningún
# intento de red. Equivalente a TRANSFORMERS_OFFLINE=1 para transformers.
#
# IMPORTANTE: estas variables se setean DESPUÉS de los pasos de pre-descarga
# (los RUN anteriores) para que el build pueda descargar libremente, pero el
# runtime no haga ningún request externo a HuggingFace.
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1
ENV HF_DATASETS_OFFLINE=1

ENV PORT=8080
EXPOSE 8080

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
