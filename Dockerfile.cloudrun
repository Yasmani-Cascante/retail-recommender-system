# ============================================================================
# DOCKERFILE PARA CLOUD RUN - RETAIL RECOMMENDER v2.1.0
# ============================================================================
FROM python:3.11-slim

# Metadata
LABEL maintainer="Retail Recommender Team"
LABEL version="2.1.0"
LABEL description="Enterprise Retail Recommendation System"

# Establecer directorio de trabajo
WORKDIR /app

# ============================================================================
# FASE 1: DEPENDENCIAS DEL SISTEMA
# ============================================================================
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# FASE 2: DEPENDENCIAS DE PYTHON
# ============================================================================
# Copiar requirements
COPY requirements.cloudrun.txt requirements.txt
# COPY requirements.cloudrun.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# ============================================================================
# FASE 3: CÓDIGO DE LA APLICACIÓN
# ============================================================================
COPY src/ /app/src/
COPY data/ /app/data/
# FIX (22/03/2026): Copiar el widget compilado al contenedor.
# Sin esta línea, static/widget/widget.umd.cjs no llega a Cloud Run
# y FastAPI no puede servirlo en /static/widget/.
COPY static/ /app/static/
# FIX (23/03/2026): Copiar modelos ML de intent detection.
# MLIntentClassifier carga model.pkl y vectorizer.pkl desde
# Path("models/intent_classifier") relativo a WORKDIR /app.
# Sin esta línea, ML_INTENT_ENABLED=true falla silenciosamente
# y el sistema degrada a rule-based sin error visible.
# Tamaño total: ~131 KB (model.pkl 24KB + vectorizer.pkl 107KB).
COPY models/ /app/models/

# ============================================================================
# FASE 3.5: MINIML LAYER-3 — PRE-DESCARGA DEL MODELO EN IMAGEN
# ============================================================================
# sentence-transformers ya esta instalado en FASE 2 (requirements.cloudrun.txt)
# y torch llega como dependencia suya. No se necesita un pip install adicional.
#
# Este paso descarga y cachea paraphrase-multilingual-MiniLM-L12-v2 (~470MB)
# dentro de la imagen Docker (~/.cache/huggingface/hub/).
# En runtime, el modelo carga desde disco sin acceso a red.
#
# CRÍTICO: debe bakearse en /app/ para que el chown de appuser lo cubra.
# Baking en /root/.cache/ → appuser no puede leerlo en runtime.
ENV MINIML_CACHE_DIR=/app/models/miniml

RUN mkdir -p /app/models/miniml && \
    TOKENIZERS_PARALLELISM=false python -c "\
from sentence_transformers import SentenceTransformer; \
m = SentenceTransformer(\
    'paraphrase-multilingual-MiniLM-L12-v2', \
    token=False, \
    cache_folder='/app/models/miniml'\
); \
m.encode(['warmup'], show_progress_bar=False); \
print('MiniLM L12 baked to /app/models/miniml OK')"

# Offline mode: impide que transformers/hf_hub contacte HuggingFace en runtime.
# El modelo ya está en /root/.cache/huggingface/hub/ (baking anterior).
# Sin esto, hf_hub hace requests de verificación XET aunque el modelo esté local.
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

# Backend: torch (sentence-transformers + torch ya instalados en FASE 2)
ENV MINILM_BACKEND=torch

# ============================================================================
# FASE 4: CONFIGURACIÓN DE RUNTIME
# ============================================================================
# Crear directorios necesarios
RUN mkdir -p /app/logs /app/data

# Variables de entorno para producción
ENV PYTHONUNBUFFERED=1
ENV ENVIRONMENT=production
ENV PORT=8080

# ============================================================================
# FASE 5: HEALTH CHECK
# ============================================================================
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# ============================================================================
# FASE 6: USUARIO NO-ROOT (SEGURIDAD)
# ============================================================================
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app
USER appuser

# ============================================================================
# FASE 7: COMANDO DE INICIO
# ============================================================================
# ✅ CRITICAL: Usar PORT env var, no hardcodear
CMD ["sh", "-c", "exec uvicorn src.api.main_unified_redis:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1 --timeout-keep-alive 300 --log-level info"]